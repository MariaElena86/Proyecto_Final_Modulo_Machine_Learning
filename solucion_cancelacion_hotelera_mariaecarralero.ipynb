   "source": [
    "# Regresión Logística balanceada\n",
    "logmodel_balanced = LogisticRegression(\n",
    "    max_iter=1000,\n",
    "    C=0.01,\n",
    "    class_weight='balanced'\n",
    ")\n",
    "\n",
    "# Entrenar el modelo\n",
    "logmodel_balanced.fit(X_train_final, y_train)\n",
    "\n",
    "# Generar predicciones sobre el conjunto de test\n",
    "y_pred_balanced = logmodel_balanced.predict(X_test_final)\n",
    "\n",
    "# Obtener probabilidades de cancelación (clase 1)\n",
    "pred_proba_balanced = logmodel_balanced.predict_proba(X_test_final)[:, 1]\n",
    "\n",
    "\n",
    "comparador.loc[len(comparador)] = metricas( y_test,\n",
    "                                            y_pred_balanced, \n",
    "                                            pred_proba_balanced, \n",
    "                                            'Logistic Regression - balanced' ) \n",
    "comparador\n"
   ]
  },
