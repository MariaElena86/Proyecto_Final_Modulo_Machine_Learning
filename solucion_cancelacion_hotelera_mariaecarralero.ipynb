   "source": [
    "# SHAP Summary Plot: Importancia global de las variables\n",
    "\n",
    "import shap\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Crear el explicador SHAP para la Regresión Logística balanceada \n",
    "explainer = shap.LinearExplainer( logmodel_balanced, X_train_final ) \n",
    "# Calcular los valores SHAP \n",
    "shap_values = explainer(X_train_final)\n",
    "\n",
    "# Crear una muestra del conjunto de entrenamiento\n",
    "X_train_shap = X_train_final.sample(\n",
    "    1000,\n",
    "    random_state=42\n",
    ")\n",
    "# Crear el background masker utilizando las 1000 muestras\n",
    "masker = shap.maskers.Independent(\n",
    "    X_train_shap,\n",
    "    max_samples=1000\n",
    ")\n",
    "# Crear el explicador SHAP\n",
    "explainer = shap.LinearExplainer(\n",
    "    logmodel_balanced,\n",
    "    masker\n",
    ")\n",
    "# Calcular los valores SHAP\n",
    "shap_values = explainer(X_train_shap)\n",
    "# SHAP Summary Plot\n",
    "shap.summary_plot( shap_values, X_train_shap, show=True )"
   ]
