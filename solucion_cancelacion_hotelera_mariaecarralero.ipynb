    "# Eliminar variables (data leakage) - variables que contienen información que solo se conoce después de realizar la reserva\n",
    "def eliminar_var_dataleakage(df):\n",
    "    df_clean = df.copy()\n",
    "    var_data_leakage = [\n",
    "        'reservation_status',\n",
    "        'reservation_status_date',\n",
    "        'assigned_room_type'\n",
    "    ]\n",
    "\n",
    "    df_clean = df_clean.drop(\n",
    "        columns=var_data_leakage,\n",
    "        errors='ignore'\n",
    "    )\n",
    "    return df_clean\n",
    "\n",
    "df_sin_dataleakage = eliminar_var_dataleakage(df_sin_outliers)\n",
    "print(df_sin_dataleakage.shape)"
   ]
