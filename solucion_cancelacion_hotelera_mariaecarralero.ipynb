    "# Analisis de ingresos\n",
    "df_ingresos = df.copy()\n",
    "\n",
    "# Duración total de la estancia\n",
    "df_ingresos[\"noches\"] = (\n",
    "    df_ingresos[\"stays_in_weekend_nights\"] +\n",
    "    df_ingresos[\"stays_in_week_nights\"]\n",
    ")\n",
    "\n",
    "# Ingreso estimado por reserva\n",
    "df_ingresos[\"ingreso_reserva\"] = (\n",
    "    df_ingresos[\"adr\"] * df_ingresos[\"noches\"]\n",
    ")\n",
    "#Calcular ingresos reales/ingreso estimado de reservas canceladas\n",
    "resumen_ingresos = (\n",
    "    df_ingresos\n",
    "    .groupby(\"hotel\")\n",
    "    .agg(\n",
    "        ingresos_reales=(\n",
    "            \"ingreso_reserva\",\n",
    "            lambda x: x[df_ingresos.loc[x.index, \"is_canceled\"] == 0].sum()\n",
    "        ),\n",
    "        ingresos_no_percibidos=(\n",
    "            \"ingreso_reserva\",\n",
    "            lambda x: x[df_ingresos.loc[x.index, \"is_canceled\"] == 1].sum()\n",
    "        )\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "resumen_ingresos\n",
    "display(resumen_ingresos)\n",
    "\n",
    "df_grafico = resumen_ingresos.copy()\n",
    "df_grafico[\"ingresos_reales_M\"] = (\n",
    "    df_grafico[\"ingresos_reales\"] / 1_000_000\n",
    ")\n",
    "df_grafico[\"ingresos_no_percibidos_M\"] = (\n",
    "    df_grafico[\"ingresos_no_percibidos\"] / 1_000_000\n",
    ")\n",
    "df_grafico = df_grafico.melt(\n",
    "    id_vars=\"hotel\",\n",
    "    value_vars=[\"ingresos_reales_M\", \"ingresos_no_percibidos_M\"],\n",
    "    var_name=\"tipo_ingreso\",\n",
    "    value_name=\"millones_euros\"\n",
    ")\n",
    "df_grafico[\"tipo_ingreso\"] = df_grafico[\"tipo_ingreso\"].map({\n",
    "    \"ingresos_reales_M\": \"Ingresos reales\",\n",
    "    \"ingresos_no_percibidos_M\": \"Ingreso de reservas canceladas\"\n",
    "})\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "\n",
    "ax = sns.barplot(\n",
    "    data=df_grafico,\n",
    "    x=\"hotel\",\n",
    "    y=\"millones_euros\",\n",
    "    hue=\"tipo_ingreso\"\n",
    ")\n",
    "\n",
    "# Añadir valores encima de las barras\n",
    "for container in ax.containers:\n",
    "    ax.bar_label(\n",
    "        container,\n",
    "        fmt=\"%.2f M€\",\n",
    "        padding=3,\n",
    "        fontsize=10,\n",
    "        fontweight=\"bold\"\n",
    "    )\n",
    "\n",
    "plt.title(\n",
    "    \"Ingresos reales/Ingreso estimado por reservas canceladas\",\n",
    "    fontsize=10,\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "plt.xlabel(\"Hotel\")\n",
    "plt.ylabel(\"Millones de euros (€M)\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
