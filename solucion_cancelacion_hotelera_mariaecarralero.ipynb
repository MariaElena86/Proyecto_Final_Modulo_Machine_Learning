    "# Carga y revisión inicial de los datos\n",
    "\n",
    "def carga_inicial():\n",
    "    # crear dataframe\n",
    "    return pd.read_csv(\"reservas_hoteleras.csv\")\n",
    "\n",
    "\n",
    "df = carga_inicial()\n",
    "# Análisis de valores faltantes\n",
    "resultado = pd.DataFrame({\n",
    "    'nulos': df.isnull().sum(),\n",
    "    'porcentaje': df.isnull().mean() * 100\n",
    "})\n",
    "resultado = resultado[resultado['nulos'] > 0].sort_values(\n",
    "    'porcentaje', ascending=False\n",
    ")\n",
    "display(df.head(5))\n",
