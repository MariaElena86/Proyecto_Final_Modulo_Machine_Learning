    "# Evolucion de la tasa de cancelacion\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Orden cronológico de los meses\n",
    "orden_meses = [\n",
    "    'January', 'February', 'March', 'April',\n",
    "    'May', 'June', 'July', 'August',\n",
    "    'September', 'October', 'November', 'December'\n",
    "]\n",
    "\n",
    "# Crear dos gráficos, uno por hotel\n",
    "fig, axes = plt.subplots(2, 1, figsize=(14, 10))\n",
    "\n",
    "hoteles = ['City Hotel', 'Resort Hotel']\n",
    "\n",
    "for ax, hotel in zip(axes, hoteles):\n",
    "\n",
    "    # Filtrar el hotel\n",
    "    df_hotel = df[df['hotel'] == hotel]\n",
    "\n",
    "    sns.countplot(\n",
    "        data=df_hotel,\n",
    "        x='arrival_date_month',\n",
    "        hue='is_canceled',\n",
    "        order=orden_meses,\n",
    "        palette=palette,\n",
    "        ax=ax\n",
    "    )\n",
    "\n",
    "    ax.set_title(f'{hotel} - Reservas canceladas y no canceladas por mes')\n",
    "    ax.set_xlabel('Mes de llegada')\n",
    "    ax.set_ylabel('Número de reservas')\n",
    "\n",
    "    ax.legend(\n",
    "        title='Estado',\n",
    "        labels=['No cancelada', 'Cancelada']\n",
    "    )\n",
    "\n",
    "    ax.tick_params(axis='x', rotation=45)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n"
   ]
  },
