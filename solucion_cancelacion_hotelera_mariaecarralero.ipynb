    "# Curva ROC-AUC\n",
    "def ROC_Curve (y_test, predictions_proba):\n",
    "    from sklearn.metrics import roc_auc_score, roc_curve\n",
    "    import matplotlib.pyplot as plt\n",
    "\n",
    "    roc_auc = roc_auc_score( y_test, predictions_proba )\n",
    "    print(f\"ROC-AUC: {roc_auc:.2f}\")\n",
    "\n",
    "    # Calcular los valores para la curva ROC\n",
    "    fpr, tpr, thresholds = roc_curve( y_test, predictions_proba )\n",
    "\n",
    "    # Graficar la curva ROC\n",
    "    plt.plot(fpr, tpr, label=f\"ROC Curve (AUC = {roc_auc:.2f})\")\n",
    "    plt.plot([0, 1], [0, 1], 'k--', label=\"Random Guess\")  # Línea diagonal para referencia\n",
    "    plt.xlabel(\"False Positive Rate\")\n",
    "    plt.ylabel(\"True Positive Rate\")\n",
    "    plt.title(\"ROC Curve\")\n",
    "    plt.legend()\n",
    "    plt.show()\n",
    "    return roc_auc\n",
    "\n",
    "# Calcular la probabilidad de cancelación (clase 1)\n",
    "pred_proba_baseline = logmodel.predict_proba(X_test_final)[:, 1]\n",
    "ROC_Curve( y_test, pred_proba_baseline)"
   ]
  },
