   "source": [
    "# Crear train y test\n",
    "def dividir_train_test_por_fecha(df):\n",
    "    df_clean = df.copy()\n",
    "    fecha_corte = pd.Timestamp('2016-12-01')\n",
    "\n",
    "    #Dividir Train/Test\n",
    "    previous_train = df_clean[ df_clean['arrival_date'] < fecha_corte ].copy() \n",
    "    previous_test = df_clean[ df_clean['arrival_date'] >= fecha_corte ].copy()\n",
    "    # Comprobar fechas \n",
    "    print( \"Última fecha en Train:\", previous_train['arrival_date'].max())\n",
    "    print( \"Primera fecha en Test:\", previous_test['arrival_date'].min() )\n",
    "\n",
    "    # Crear variable objetivo \n",
    "    y_train = previous_train['is_canceled'] \n",
    "    y_test = previous_test['is_canceled']\n",
    "\n",
    "\n",
    "    # Variables no necesarias para predecir\n",
    "    delete_vars = [ 'is_canceled', 'arrival_date' ]\n",
    "    \n",
    "    # Crea X_train, X_test \n",
    "    X_train = previous_train.drop( columns=delete_vars, errors='ignore' ) \n",
    "    X_test = previous_test.drop( columns=delete_vars, errors='ignore' )\n",
    "    \n",
    "    print( \"¿Mismas columnas en X_train y X_test?:\", X_train.columns.equals(X_test.columns) )\n",
    "\n",
    "    return X_train, X_test, y_train, y_test, df_clean\n",
    "\n",
    "df_feature = df_cleaned.copy()\n",
    "X_train, X_test, y_train, y_test, df_clean = dividir_train_test_por_fecha( df_feature )\n",
    "\n",
    "print(\"X_train:\", X_train.shape)\n",
    "print(\"X_test:\", X_test.shape)\n",
    "print(\"y_train:\", y_train.shape)\n",
    "print(\"y_test:\", y_test.shape)\n",
    "\n"
   ]
  },
