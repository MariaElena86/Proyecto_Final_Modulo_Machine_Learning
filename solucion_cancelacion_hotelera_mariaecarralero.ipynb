    "# StandardScaler - Escalar variables numéricas\n",
    "def scale_numeric_variables(X_train, X_test, num_vars):\n",
    "\n",
    "    from sklearn.preprocessing import StandardScaler\n",
    "    import pandas as pd\n",
    "\n",
    "    scaler = StandardScaler()    \n",
    "    display(\"Variables numericas a transformar\", num_vars)\n",
    "\n",
    "    # Ajustar SOLO con Train\n",
    "    train_scaled = scaler.fit_transform(\n",
    "        X_train[num_vars]\n",
    "    )\n",
    "\n",
    "    # Transformar Test con el scaler aprendido en Train\n",
    "    test_scaled = scaler.transform(\n",
    "        X_test[num_vars]\n",
    "    )\n",
    "\n",
    "    # Crear DataFrames\n",
    "    train_scaled_df = pd.DataFrame(\n",
    "        train_scaled,\n",
    "        columns=num_vars,\n",
    "        index=X_train.index\n",
    "    )\n",
    "\n",
    "    test_scaled_df = pd.DataFrame(\n",
    "        test_scaled,\n",
    "        columns=num_vars,\n",
    "        index=X_test.index\n",
    "    )\n",
    "\n",
    "    # Copiar los datasets\n",
    "    X_train_scaled = X_train.copy()\n",
    "    X_test_scaled = X_test.copy()\n",
    "\n",
    "    # Reemplazar las numéricas\n",
    "    X_train_scaled[num_vars] = train_scaled_df\n",
    "    X_test_scaled[num_vars] = test_scaled_df\n",
    "\n",
    "    return X_train_scaled, X_test_scaled, scaler\n",
    "\n",
    "num_vars = tipo_variables(X_train)[0] \n",
    "X_train_final, X_test_final, scaler = scale_numeric_variables( X_train_encoded, X_test_encoded, num_vars )\n",
    "\n",
    "\n",
    "\n",
    "display(\"Media de las variables numéricas:\", X_train_final[num_vars].mean().round(2))\n",
    "display(\"Desviación estándar:\", X_train_final[num_vars].std().round(2))\n",
    "print(X_train_final.head())\n"
   ]
  },
