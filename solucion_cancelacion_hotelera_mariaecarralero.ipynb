    "# XGBoost\n",
    "\n",
    "import xgboost as xgb\n",
    "from xgboost import XGBClassifier\n",
    "#Crear el modelo\n",
    "XGB_model = XGBClassifier(\n",
    "    objective='binary:logistic',  \n",
    "    max_depth=3,                \n",
    "    learning_rate=0.1,          \n",
    "    n_estimators=50,            \n",
    "    seed=42                     \n",
    ")\n",
    "#Entrenar el modelo\n",
    "XGB_model.fit(X_train_final, y_train)\n",
    "\n",
    "# Realizar predicciones sobre el conjunto de prueba\n",
    "y_pred_xgb = XGB_model.predict(X_test_final)\n",
    "pred_proba_xgb = XGB_model.predict_proba(X_test_final)[:, 1]\n",
    "\n",
    "comparador.loc[len(comparador)] = metricas( y_test,\n",
    "                                            y_pred_xgb, \n",
    "                                            pred_proba_xgb, \n",
    "                                            'XGBoost' ) \n",
    "comparador\n"
   ]
  },
