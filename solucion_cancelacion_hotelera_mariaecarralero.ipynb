    "# Distribución de la variable objetivo \"is_canceled\" (1 = reserva cancelada, 0 = no cancelada) \n",
    "print(df[\"is_canceled\"].value_counts())\n",
    "print(f\"\\nTasa de cancelación: {df['is_canceled'].mean():.1%}\")\n",
    "\n",
