    "# Matriz de confusión\n",
    "def confusion_matrix_modelo(y_test, predictions):\n",
    "    from sklearn.metrics import confusion_matrix\n",
    "    cm = confusion_matrix(y_test, predictions, labels=[1, 0])\n",
    "\n",
    "    sns.heatmap(cm, \n",
    "                annot=True, \n",
    "                fmt=\"d\", \n",
    "                cmap=\"Blues\", \n",
    "                xticklabels=[\"Clase 1\", \"Clase 0\"], \n",
    "                yticklabels=[\"Clase 1\", \"Clase 0\"])\n",
    "    plt.xlabel(\"Predicción\")\n",
    "    plt.ylabel(\"Real\")\n",
    "    plt.title(\"Matriz de Confusión\")\n",
    "    plt.show()\n",
    "    return\n",
    "\n",
    "confusion_matrix_modelo(y_test, y_pred_log)\n"
   ]
