   "source": [
    "# Detección y eliminacion de Outliers - Metodod IQR\n",
    "pd.set_option('display.max_colwidth', None) #Mostrar listas completas sin truncar\n",
    "variables_outliers = [\n",
    "    'lead_time',\n",
    "    'stays_in_week_nights',\n",
    "    'days_in_waiting_list',\n",
    "    'adr'\n",
    "]\n",
    "outliers_resumen = []\n",
    "diccionario_outliers = {}\n",
    "for variable in variables_outliers:\n",
    "    data = pd.to_numeric(df_sin_nulos[variable], errors='coerce').dropna()\n",
    "    Q1 = data.quantile(0.25)\n",
    "    Q3 = data.quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    limite_inferior = Q1 - 1.5 * IQR\n",
    "    limite_superior = Q3 + 1.5 * IQR\n",
    "    valores_extremos = data[(data < limite_inferior) | (data > limite_superior)]    \n",
    "    diccionario_outliers[variable] = valores_extremos.tolist()    \n",
    "    outliers_resumen.append({\n",
    "        'variable': variable,\n",
    "        'Q1': Q1,\n",
    "        'Q3': Q3,\n",
    "        'limite_inferior': limite_inferior,\n",
    "        'limite_superior': limite_superior,\n",
    "        'cantidad_outliers': len(valores_extremos),\n",
    "        'porcentaje_outliers': len(valores_extremos) / len(data) * 100,\n",
    "        'extremo_inferior': df[variable].min(),\n",
    "        'extremo_superior': df[variable].max()\n",
    "    })\n",
    "display(pd.DataFrame(outliers_resumen))\n",
    "\n",
    "# Eliminar valores extremos de adr\n",
    "def eliminar_outliers(df):\n",
    "    df_clean = df.copy()\n",
    "    df_clean = df[\n",
    "        (df['adr'] != df['adr'].min()) &\n",
    "        (df['adr'] != df['adr'].max())\n",
    "    ].copy()\n",
    "    return df_clean\n",
    "\n",
    "df_sin_outliers = eliminar_outliers(df_sin_nulos)\n",
    "\n",
    "# Comprobar resultados\n",
    "display(df_sin_outliers)\n",
    "print(\"Registros antes:\", df_sin_nulos.shape[0]) \n",
    "print(\"Registros después:\", df_sin_outliers.shape[0])"
   ]
  },
