   "source": [
    "# OneHotEncoder - Transformar variables categoricas\n",
    "\n",
    "def transformar_var_categoricas(X_train, X_test, cat_vars):\n",
    "\n",
    "    from sklearn.preprocessing import OneHotEncoder\n",
    "    import pandas as pd\n",
    "\n",
    "    X_train_transformado = X_train.copy()\n",
    "    X_test_transformado = X_test.copy()    \n",
    "    display(\"Variables categoricas a transformar\", cat_vars)\n",
    "\n",
    "    for variable in cat_vars:\n",
    "        encoder = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\n",
    "\n",
    "        # Train: aprender las categorías y transformar\n",
    "        train_encoded = encoder.fit_transform(\n",
    "            X_train[[variable]]\n",
    "        )\n",
    "\n",
    "        # Test: transformar usando las categorías aprendidas en Train\n",
    "        test_encoded = encoder.transform(\n",
    "            X_test[[variable]]\n",
    "        )\n",
    "\n",
    "        # Nombre de las nuevas columnas\n",
    "        column_names = encoder.get_feature_names_out(\n",
    "            [variable]\n",
    "        )\n",
    "\n",
    "        # DataFrame de Train\n",
    "        train_encoded_df = pd.DataFrame(\n",
    "            train_encoded,\n",
    "            columns=column_names,\n",
    "            index=X_train.index\n",
    "        )\n",
    "\n",
    "        # DataFrame de Test\n",
    "        test_encoded_df = pd.DataFrame(\n",
    "            test_encoded,\n",
    "            columns=column_names,\n",
    "            index=X_test.index\n",
    "        )\n",
    "\n",
    "        # Añadir columnas nuevas\n",
    "        X_train_transformado = pd.concat(\n",
    "            [X_train_transformado, train_encoded_df],\n",
    "            axis=1\n",
    "        )\n",
    "\n",
    "        X_test_transformado = pd.concat(\n",
    "            [X_test_transformado, test_encoded_df],\n",
    "            axis=1\n",
    "        )\n",
    "\n",
    "        # Eliminar la variable categórica original\n",
    "        X_train_transformado.drop(\n",
    "            columns=[variable],\n",
    "            inplace=True\n",
    "        )\n",
    "\n",
    "        X_test_transformado.drop(\n",
    "            columns=[variable],\n",
    "            inplace=True\n",
    "        )\n",
    "\n",
    "    return X_train_transformado, X_test_transformado\n",
    "\n",
    "cat_vars = tipo_variables(X_train)[1]\n",
    "X_train_encoded, X_test_encoded = transformar_var_categoricas( X_train, X_test, cat_vars)\n",
    "print(\"X_train antes:\", X_train.shape)\n",
    "print(\"X_train después:\", X_train_encoded.shape)\n",
    "\n",
    "print(\"X_test antes:\", X_test.shape)\n",
    "print(\"X_test después:\", X_test_encoded.shape)"
   ]
