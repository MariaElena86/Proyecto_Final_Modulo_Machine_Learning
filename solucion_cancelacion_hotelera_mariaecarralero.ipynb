   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Nulos en country: 0\n",
      "Nulos en children: 0\n",
      "Nulos en agent: 0\n"
     ]
    }
   ],
   "source": [
    "# Eliminar e Imputar registros con null\n",
    "def eliminar_registros_nulos(df):\n",
    "    df_clean = df.copy() \n",
    "    # Eliminar company por su elevado porcentaje de nulos \n",
    "    df_clean = df_clean.drop(columns=['company']) \n",
    "\n",
    "    # Imputar variables categóricas\n",
    "    df_clean['country'] = df_clean['country'].fillna('Desconocido') \n",
    "\n",
    "    # Imputar variables numéricas \n",
    "    df_clean['children'] = df_clean['children'].fillna(0) \n",
    "\n",
    "    # Imputar agent con la media \n",
    "    df_clean['agent'] = df_clean['agent'].fillna(df_clean['agent'].mean() ) \n",
    "\n",
    "    return df_clean\n",
    "\n",
    "df_sin_nulos = eliminar_registros_nulos(df)\n",
    "\n",
    "print(\"Nulos en country:\", df_sin_nulos['country'].isnull().sum())\n",
    "print(\"Nulos en children:\", df_sin_nulos['children'].isnull().sum()) \n",
    "print(\"Nulos en agent:\", df_sin_nulos['agent'].isnull().sum())"
   ]
  },
