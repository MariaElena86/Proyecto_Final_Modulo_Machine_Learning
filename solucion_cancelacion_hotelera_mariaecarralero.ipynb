    "# Analisis del inpacto del lead_time (tiempo entre la reserva y la llegada) en la cancelación de reservas.\n",
    "df_lead = df.copy()\n",
    "\n",
    "# Crear intervalos de lead time\n",
    "bins = [0, 7, 14, 30, 60, 90, 180, 365, float(\"inf\")]\n",
    "labels = [\n",
    "    \"0-7 días\", #→ reservas realizadas con poca antelación.\n",
    "    \"8-14 días\",\n",
    "    \"15-30 días\",\n",
    "    \"31-60 días\",# → reservas realizadas con 1-2 meses de antelación.\n",
    "    \"61-90 días\",\n",
    "    \"91-180 días\",\n",
    "    \"181-365 días\",\n",
    "    \"+365 días\" #→ reservas realizadas con más de un año de antelación.\n",
    "]\n",
    "\n",
    "df_lead[\"rango_lead_time\"] = pd.cut(\n",
    "    df_lead[\"lead_time\"],\n",
    "    bins=bins,\n",
    "    labels=labels,\n",
    "    include_lowest=True\n",
    ")\n",
    "\n",
    "# Calcular tasa de cancelación\n",
    "tasa_lead = (\n",
    "    df_lead\n",
    "    .groupby(\"rango_lead_time\", observed=False)\n",
    "    .agg(\n",
    "        total_reservas=(\"is_canceled\", \"count\"),\n",
    "        reservas_canceladas=(\"is_canceled\", \"sum\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "tasa_lead[\"tasa_cancelacion\"] = (\n",
    "    tasa_lead[\"reservas_canceladas\"] /\n",
    "    tasa_lead[\"total_reservas\"] * 100\n",
    ")\n",
    "display(tasa_lead)\n",
    "plt.figure(figsize=(10, 6))\n",
    "\n",
    "ax = sns.barplot(\n",
    "    data=tasa_lead,\n",
    "    x=\"rango_lead_time\",\n",
    "    y=\"tasa_cancelacion\"\n",
    ")\n",
    "for container in ax.containers:\n",
    "    ax.bar_label(\n",
    "        container,\n",
    "        padding=3,\n",
    "        fontsize=9\n",
    "    )\n",
    "\n",
    "plt.title(\n",
    "    \"Tasa de cancelación según el tiempo entre reserva y llegada\",\n",
    "    fontsize=10,\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "plt.xlabel(\"Tiempo entre reserva y llegada\")\n",
    "plt.ylabel(\"Tasa de cancelación (%)\")\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
