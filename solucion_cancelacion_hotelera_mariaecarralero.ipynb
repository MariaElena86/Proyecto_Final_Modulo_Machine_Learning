    "# ADR medio según estado de la reserva\n",
    "adr_medio = (\n",
    "    df.groupby('is_canceled')['adr']\n",
    "      .mean()\n",
    "      .reset_index()\n",
    ")\n",
    "\n",
    "# Cambiar etiquetas\n",
    "adr_medio['estado'] = adr_medio['is_canceled'].map({\n",
    "    0: 'No cancelada',\n",
    "    1: 'Cancelada'\n",
    "})\n",
    "\n",
    "# Gráfico\n",
    "plt.figure(figsize=(8, 5))\n",
    "\n",
    "ax = sns.barplot(\n",
    "    data=adr_medio,\n",
    "    x='estado',\n",
