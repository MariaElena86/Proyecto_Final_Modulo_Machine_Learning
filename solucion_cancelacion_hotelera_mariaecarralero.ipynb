    "# Modelo Regresión Logística - baseline\n",
    "display(\"Datos train\", X_train_final)\n",
    "display(\"Datos test\", X_test_final)\n",
    "\n",
    "\n",
    "from sklearn.linear_model import LogisticRegression \n",
    "\n",
    "# Crear el Modelo\n",
    "logmodel = LogisticRegression( max_iter=1000, C=0.01 ) \n",
    "\n",
    "# Entrenar el modelo\n",
    "logmodel.fit(X_train_final, y_train)\n",
    "\n",
    "# Generar predicciones sobre el conjunto de test \n",
    "y_pred_log = logmodel.predict(X_test_final) "
   ]
