    "# Análisis de coeficientes\n",
    "\n",
    "coeficientes = logmodel.coef_[0]\n",
    "# Emparejar coeficientes con nombres de variables\n",
    "importancia = pd.DataFrame({\n",
    "    'variable': X_train_final.columns,\n",
    "    'coeficiente': coeficientes\n",
    "})\n",
    "# 10 coeficientes positivos más altos\n",
    "positivos = importancia.nlargest(10, 'coeficiente')\n",
    "# 10 coeficientes negativos más bajos\n",
    "negativos = importancia.nsmallest(10, 'coeficiente')\n",
    "\n",
    "# Unir ambos grupos\n",
    "importancia_top = pd.concat([positivos, negativos])\n",
    "\n",
    "# Ordenar para el gráfico\n",
    "importancia_top = importancia_top.sort_values(by='coeficiente')\n",
    "\n",
    "# Gráfico\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.barplot(data=importancia_top, x='coeficiente', y='variable', palette='coolwarm')\n",
    "plt.title('Principales coeficientes de la Regresión Logística')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
