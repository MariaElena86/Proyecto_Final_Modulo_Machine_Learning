    "def ROC_Curves_general(y_test, predictions_proba):\n",
    "    from sklearn.metrics import roc_auc_score, roc_curve\n",
    "    import matplotlib.pyplot as plt\n",
    "\n",
    "    plt.figure(figsize=(9, 7))\n",
    "\n",
    "    for model_name, proba in predictions_proba.items():\n",
    "        roc_auc = roc_auc_score(y_test, proba)\n",
    "        fpr, tpr, _ = roc_curve(y_test, proba)\n",
    "\n",
    "        plt.plot(\n",
    "            fpr,\n",
    "            tpr,\n",
    "            label=f\"{model_name} (AUC = {roc_auc:.3f})\"\n",
    "        )\n",
    "\n",
    "    # Línea de clasificación aleatoria\n",
    "    plt.plot(\n",
    "        [0, 1],\n",
    "        [0, 1],\n",
    "        \"k--\",\n",
    "        label=\"Random Guess\"\n",
    "    )\n",
    "\n",
    "    plt.xlabel(\"False Positive Rate\")\n",
    "    plt.ylabel(\"True Positive Rate\")\n",
    "    plt.title(\"ROC Curves - Comparación de modelos\")\n",
    "    plt.legend(loc=\"lower right\")\n",
    "    plt.grid(alpha=0.2)\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "\n",
    "predictions_proba = {\n",
    "\"Logistic Regression - baseline\": pred_proba_baseline,\n",
    "\"Logistic Regression - balanced\": pred_proba_balanced,\n",
    "\"Decision Tree\": pred_proba_tree,\n",
    "\"XGBoost\": pred_proba_xgb,\n",
    "\"Random Forest\": pred_proba_rf_optimized\n",
    "}\n",
    "\n",
    "ROC_Curves_general(y_test, predictions_proba)"
   ]
  },
