   "source": [
    "# Analisis del inpacto del canal de distribución en la cancelación de reservas\n",
    "\n",
    "df_canal = df.copy()\n",
    "\n",
    "# Calcular reservas totales y canceladas por canal\n",
    "tasa_canal = (\n",
    "    df_canal\n",
    "    .groupby(\"distribution_channel\")\n",
    "    .agg(\n",
    "        total_reservas=(\"is_canceled\", \"count\"),\n",
    "        reservas_canceladas=(\"is_canceled\", \"sum\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# Calcular tasa de cancelación\n",
    "tasa_canal[\"tasa_cancelacion\"] = (\n",
    "    tasa_canal[\"reservas_canceladas\"] /\n",
    "    tasa_canal[\"total_reservas\"] * 100\n",
    ")\n",
    "# Ordenar de mayor a menor tasa de cancelación\n",
    "tasa_canal = tasa_canal.sort_values(\n",
    "    \"tasa_cancelacion\",\n",
    "    ascending=False\n",
    ")\n",
    "display(tasa_canal)\n",
    "\n",
    "# Gráfico: volumen de reservas y cancelaciones por canal\n",
    "df_grafico = tasa_canal.copy()\n",
    "df_grafico = df_grafico.melt(\n",
    "    id_vars=\"distribution_channel\",\n",
    "    value_vars=[\"total_reservas\", \"reservas_canceladas\"],\n",
    "    var_name=\"tipo_reserva\",\n",
    "    value_name=\"numero_reservas\"\n",
    ")\n",
    "df_grafico[\"tipo_reserva\"] = df_grafico[\"tipo_reserva\"].map({\n",
    "    \"total_reservas\": \"Total reservas\",\n",
    "    \"reservas_canceladas\": \"Reservas canceladas\"\n",
    "})\n",
    "\n",
    "# Ordenar según volumen total de reservas\n",
    "orden_canales = (\n",
    "    tasa_canal\n",
    "    .sort_values(\"total_reservas\", ascending=False)\n",
    "    [\"distribution_channel\"]\n",
    ")\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "\n",
    "ax = sns.barplot(\n",
    "    data=df_grafico,\n",
    "    x=\"distribution_channel\",\n",
    "    y=\"numero_reservas\",\n",
    "    hue=\"tipo_reserva\",\n",
    "    order=orden_canales\n",
    ")\n",
    "\n",
    "for container in ax.containers:\n",
    "    ax.bar_label(\n",
    "        container,\n",
    "        fmt=\"%.0f\",\n",
    "        padding=3,\n",
    "        fontsize=9\n",
    "    )\n",
    "\n",
    "plt.title(\n",
    "    \"Volumen de reservas y cancelaciones por canal de distribución\",\n",
    "    fontsize=14,\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "plt.xlabel(\"Canal de distribución\")\n",
    "plt.ylabel(\"Número de reservas\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
